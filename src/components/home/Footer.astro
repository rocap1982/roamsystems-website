---
/**
 * Shared dark-industrial footer — used by HomeLayout.astro and Layout.astro
 * so every page has a consistent brand footer.
 */
---

<footer class="relative border-t border-[color:var(--color-ink-600)] bg-[color:var(--color-ink-950)] py-16 md:py-20 text-[color:var(--color-ink-100)]">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Brand column -->
      <div>
        <img src="/images/roam-systems-logo.png" alt="ROAM Systems" class="h-28 md:h-32 w-auto" />
        <p class="mt-6 max-w-sm text-sm text-[color:var(--color-ink-300)]">
          Precision-engineered campervan furniture.<br />
          Made in the UK by Romark Engineering Ltd.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <div class="rounded-sm border border-[color:var(--color-ink-600)] bg-[color:var(--color-ink-800)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-[color:var(--color-ink-200)]">ECE 14.09</div>
          <div class="rounded-sm border border-[color:var(--color-ink-600)] bg-[color:var(--color-ink-800)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-[color:var(--color-ink-200)]">RCD 015033319</div>
          <div class="rounded-sm border border-[color:var(--color-ink-600)] bg-[color:var(--color-ink-800)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-[color:var(--color-ink-200)]">M1 Certified</div>
        </div>
        <div class="mt-6 flex gap-4">
          <a href="https://www.facebook.com/roamsystems" target="_blank" rel="noopener" class="text-[color:var(--color-ink-300)] hover:text-[color:var(--color-amber-base)] transition-colors" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.youtube.com/@roamsystems" target="_blank" rel="noopener" class="text-[color:var(--color-ink-300)] hover:text-[color:var(--color-amber-base)] transition-colors" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/><polygon fill="#0f0f10" points="9.545,15.568 15.818,12 9.545,8.432"/></svg>
          </a>
          <a href="https://www.instagram.com/roamsystems_m1ushape" target="_blank" rel="noopener" class="text-[color:var(--color-ink-300)] hover:text-[color:var(--color-amber-base)] transition-colors" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>

      <!-- Products column -->
      <div>
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-[color:var(--color-amber-base)]"></span>
          <h4 class="text-xs font-black uppercase tracking-[0.2em] text-[color:var(--color-amber-base)]">Products</h4>
        </div>
        <ul class="mt-5 space-y-3">
          <li><a href="/products" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">All Furniture</a></li>
          <li><a href="/products?category=Frames" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Frames</a></li>
          <li><a href="/products?category=Upholstery" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Upholstery</a></li>
          <li><a href="/products?category=Kitchens" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Kitchens</a></li>
          <li><a href="/vehicles" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Vehicles</a></li>
        </ul>
      </div>

      <!-- Support column -->
      <div>
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-[color:var(--color-amber-base)]"></span>
          <h4 class="text-xs font-black uppercase tracking-[0.2em] text-[color:var(--color-amber-base)]">Support</h4>
        </div>
        <ul class="mt-5 space-y-3">
          <li><a href="/installers" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Installers</a></li>
          <li><a href="/delivery" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Delivery</a></li>
          <li><a href="/certifications" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Certifications</a></li>
          <li><a href="/blog" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Blog</a></li>
          <li><a href="/gallery" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Gallery</a></li>
          <li><a href="/contact" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Contact</a></li>
        </ul>
      </div>

      <!-- Legal column -->
      <div>
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-[color:var(--color-amber-base)]"></span>
          <h4 class="text-xs font-black uppercase tracking-[0.2em] text-[color:var(--color-amber-base)]">Legal</h4>
        </div>
        <ul class="mt-5 space-y-3">
          <li><a href="/policies/privacy" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Privacy</a></li>
          <li><a href="/policies/terms" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Terms</a></li>
          <li><a href="/policies/shipping" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Shipping</a></li>
          <li><a href="/policies/refund" class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-ink-200)] transition-colors hover:text-[color:var(--color-amber-base)]">Refund</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-[color:var(--color-ink-600)] pt-8 md:flex-row md:items-center">
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-ink-400)]">
        &copy; {new Date().getFullYear()} ROAM Systems. Manufactured by Romark Engineering Ltd, Essex.
      </p>
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-ink-400)]">
        <a href="mailto:sales@roamsystems.co.uk" class="transition-colors hover:text-[color:var(--color-amber-base)]">sales@roamsystems.co.uk</a>
      </p>
    </div>
  </div>
</footer>
