---
/**
 * DRAFT installation page for the ROAM rear travel seat.
 * Not linked from navigation, excluded from the sitemap and marked noindex.
 * Not for issue until approved by the owner (see docs/sprints/CURRENT_STATUS.md).
 * Hole positions in Figure 3 are taken from the owner's SolidWorks model
 * ("2022 Bed system full assy"). All other figures are schematics, not to scale.
 */
import Layout from '../layouts/Layout.astro';
// Clean seat side view (silhouette + cushion section, in mm) generated from the SolidWorks model
// by docs/business-assets/installation/source/hc_seatclean.py. x from ski heel (front negative), y up.
import seat from '../data/install/seat-clean.json';

const ORANGE = '#f47d23';
const DARK = '#1a1a1a';
const GREY = '#9ca3af';
const LIGHT = '#f5f5f5';

// Figure 3: fixing holes, mm from the ski heel (CAD), drawn at 0.32 px/mm
const holes = [19, 55, 169, 301, 431, 625];
const sc = 0.32;
const heelY = 400;
const yOf = (d: number) => heelY - d * sc;
const skiLen = 670;
const leftX = 210;
const rightX = leftX + 1114 * sc;

// Figures 1 and 2: seat, D pillar, floor and lip drawn to one scale, seat at the 80mm position.
// D pillar from the owner's T6 measurement: underside 1300mm above floor, 100mm deep from the rear doors
// (door face assumed level with the lip; not yet confirmed).
const LIP = 80;
const MEAS = 115; // roof was measured with the seat fitted at 115mm from the lip
const f1 = { s: 0.25, x0: 560, y0: 395 };
const X1 = (mm: number) => f1.x0 + mm * f1.s;
const Y1 = (mm: number) => f1.y0 - mm * f1.s;
const f2 = { s: 0.22, x0: 275, y0: 350 };
const X2 = (mm: number) => f2.x0 + mm * f2.s;
const Y2 = (mm: number) => f2.y0 - mm * f2.s;
// illustrative occupant on the 13 degree backrest line from the R point
const R = seat.r_point;
const along = (l: number) => [R[0] + l * Math.sin((13 * Math.PI) / 180), R[1] + l * Math.cos((13 * Math.PI) / 180)];
const head = along(757.5);
const neck = along(660);
---

<Layout
  title="Rear Seat Installation (Draft)"
  description="DRAFT: installation information for the ROAM rear travel seat, for experienced installers."
  noindex
>
  <!-- Draft banner -->
  <div class="bg-red-700 text-white text-center text-sm font-heading font-bold py-2 px-4">
    DRAFT FOR REVIEW. NOT FOR ISSUE. Not yet approved by ROAM Systems.
  </div>

  <!-- Header -->
  <section class="bg-roam-dark text-white py-16">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <span class="text-roam-orange font-heading font-semibold text-sm uppercase tracking-wider">For experienced installers</span>
      <h1 class="font-heading text-4xl md:text-5xl font-extrabold mt-2 mb-4">Rear Seat Installation</h1>
      <p class="text-gray-300 max-w-3xl mx-auto">
        Every van is different. This page sets out what stays the same on every ROAM rear seat installation,
        and the judgement calls you will need to make on each vehicle.
      </p>
    </div>
  </section>

  <!-- Contents -->
  <section class="bg-roam-light py-8 border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-4">
      <ol class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-sm font-heading font-semibold">
        <li><a class="hover:text-roam-orange" href="#tested">1. What is tested</a></li>
        <li><a class="hover:text-roam-orange" href="#fixed">2. Same on every install</a></li>
        <li><a class="hover:text-roam-orange" href="#position">3. Seat position</a></li>
        <li><a class="hover:text-roam-orange" href="#head">4. Head clearance</a></li>
        <li><a class="hover:text-roam-orange" href="#underbody">5. Underbody and plates</a></li>
        <li><a class="hover:text-roam-orange" href="#fixings">6. Drilling and fixing</a></li>
        <li><a class="hover:text-roam-orange" href="#judgement">7. Your judgement calls</a></li>
        <li><a class="hover:text-roam-orange" href="#handover">8. Handover</a></li>
      </ol>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 py-12 space-y-16 text-gray-700 leading-relaxed">

    <!-- 1 Tested -->
    <section id="tested" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">1. What is tested</h2>
      <p class="mb-4">The rear belted travel seat is M1 tested:</p>
      <ul class="list-disc pl-6 space-y-1 mb-4">
        <li>Seat belt anchorage pull test to M1 loads, ECE R14.09 (VO00269, 18 March 2021). Passed.</li>
        <li>ISOFIX anchorage test, ECE R145 (VO00270, 23 March 2021). Passed.</li>
      </ul>
      <p class="mb-4">
        These were static pull tests with the seat fixed to a steel plate test structure with 12 x M12 bolts.
        The seat was not tested in a vehicle, and it was not a crash test. The tests do not cover the vehicle floor
        or chassis, or head clearance.
      </p>
      <div class="border-l-4 border-roam-orange bg-orange-50 p-4">
        <p class="font-semibold text-roam-dark">The side bench sections are not tested and are for stationary use only.
        They must not be used as seats when travelling.</p>
      </div>
    </section>

    <!-- 2 Fixed -->
    <section id="fixed" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">2. The same on every install</h2>
      <div class="bg-roam-dark text-white rounded-xl p-6">
        <ul class="space-y-3">
          <li><strong class="text-roam-orange">All 12 fixings</strong> wherever they can be reached. The rear 4 on each side (rear 8 in total) are a must. The seat was tested with all 12.</li>
          <li><strong class="text-roam-orange">M12 bolts,</strong> minimum grade 8.8, with nyloc nuts. <strong class="text-roam-orange">13mm holes.</strong></li>
          <li><strong class="text-roam-orange">A steel plate under every fixing,</strong> at least 100 x 100 x 4mm.</li>
          <li><strong class="text-roam-orange">At least two full threads</strong> through the nyloc, with all plates and washers fitted. If a bolt comes up short, do not fit it. Let us know and we will send longer ones free of charge.</li>
          <li><strong class="text-roam-orange">Seal every hole,</strong> including any drilled and not used.</li>
          <li><strong class="text-roam-orange">Re-check the fixings</strong> after the first 500 miles.</li>
        </ul>
      </div>
    </section>

    <!-- 3 Position -->
    <section id="position" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">3. Seat position</h2>
      <ul class="list-disc pl-6 space-y-2 mb-6">
        <li>Measure from a straight edge across the two ski heels to the lip of the van.</li>
        <li>80mm is the furthest back the seat can go, and only if the seat belt reels are at least 20mm clear of the rear window with the doors or tailgate closed.</li>
        <li>Moving the seat forward gives more head clearance, but it changes what each fixing lands on underneath. Decide the position from the head clearance check (section 4) and the underbody survey (section 5) before you drill.</li>
        <li>Our figures were taken from a VW T6. On other vehicles and wheelbases, treat them as a starting point only.</li>
      </ul>

      <figure class="bg-white border border-gray-200 rounded-xl p-4">
        <svg viewBox="0 0 770 450" class="w-full h-auto" role="img" aria-label="Side view of the ROAM rear seat at the 80mm position, showing the measurement from the ski heels to the van lip, the D pillar and the belt reel clearance to the rear window">
          <rect width="770" height="450" fill="white" />
          <!-- van: roof line, floor, lip step, rear door with glass -->
          <line x1="40" y1={Y1(0)} x2={X1(LIP)} y2={Y1(0)} stroke={DARK} stroke-width="3" />
          <polyline points={`${X1(LIP)},${Y1(0)} ${X1(LIP)},${Y1(0) + 12} 720,${Y1(0) + 12}`} fill="none" stroke={DARK} stroke-width="3" />
          <rect x={X1(LIP)} y={Y1(1306)} width="12" height={Y1(0) + 12 - Y1(1306)} fill={LIGHT} stroke={DARK} stroke-width="2" />
          <rect x={X1(LIP)} y={Y1(1250)} width="12" height="150" fill="#cfe8f7" stroke={DARK} stroke-width="2" />
          <text x={X1(LIP) + 22} y={Y1(1080)} font-size="13" fill={DARK}>Rear</text>
          <text x={X1(LIP) + 22} y={Y1(1080) + 16} font-size="13" fill={DARK}>window</text>
          <!-- rear header (D pillar) and roof, measured on a VW T6 LWB -->
          <g transform={`translate(${X1(LIP - MEAS)} ${f1.y0}) scale(${f1.s} ${-f1.s})`}>
            <rect x="0" y="1306" width={MEAS} height="188" fill="#6b7280" />
            <path d={seat.roof} fill="#6b7280" stroke={DARK} stroke-width="1.2" vector-effect="non-scaling-stroke" />
          </g>
          <line x1={X1(LIP - 160)} y1={Y1(1306) + 2} x2="430" y2="62" stroke={GREY} stroke-width="1" />
          <text x="426" y="52" font-size="13" fill={DARK} text-anchor="end">D pillar / rear header,</text>
          <text x="426" y="68" font-size="13" fill={DARK} text-anchor="end">underside 1306mm above floor</text>
          <!-- ROAM rear seat -->
          <g transform={`translate(${f1.x0} ${f1.y0}) scale(${f1.s} ${-f1.s})`}>
            {seat.cushions.map((d) => <path d={d} fill={ORANGE} stroke="#b45f02" stroke-width="1" vector-effect="non-scaling-stroke" />)}
            <path d={seat.frame} fill="#d4d4d8" fill-rule="evenodd" stroke={DARK} stroke-width="1.4" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            <path d={seat.detail} fill="none" stroke="#52525b" stroke-width="0.8" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          </g>
          <!-- belt reel -->
          <rect x={X1(-62)} y={Y1(1000)} width="9" height="18" fill={DARK} />
          <line x1="430" y1="150" x2={X1(-62) - 2} y2={Y1(969)} stroke={GREY} stroke-width="1" />
          <text x="426" y="154" font-size="13" fill={DARK} text-anchor="end">Seat belt reel (upper anchorage)</text>
          <!-- reel gap -->
          <line x1={X1(-62) + 9} y1={Y1(940)} x2={X1(LIP)} y2={Y1(940)} stroke={ORANGE} stroke-width="2" />
          <line x1={X1(LIP) + 6} y1={Y1(940)} x2="640" y2={Y1(760)} stroke={GREY} stroke-width="1" />
          <text x="644" y={Y1(760) + 4} font-size="13" font-weight="700" fill={ORANGE}>at least 20mm,</text>
          <text x="644" y={Y1(760) + 20} font-size="13" fill={DARK}>doors closed</text>
          <!-- straight edge and lip dimension -->
          <line x1={X1(0)} y1={Y1(150)} x2={X1(0)} y2="432" stroke={DARK} stroke-width="1.5" stroke-dasharray="4 3" />
          <line x1={X1(LIP)} y1={Y1(0) + 12} x2={X1(LIP)} y2="432" stroke={DARK} stroke-width="1.5" stroke-dasharray="4 3" />
          <line x1={X1(0) - 30} y1="424" x2={X1(0)} y2="424" stroke={ORANGE} stroke-width="2.5" />
          <polygon points={`${X1(0)},424 ${X1(0) - 9},419 ${X1(0) - 9},429`} fill={ORANGE} />
          <line x1={X1(LIP)} y1="424" x2={X1(LIP) + 30} y2="424" stroke={ORANGE} stroke-width="2.5" />
          <polygon points={`${X1(LIP)},424 ${X1(LIP) + 9},419 ${X1(LIP) + 9},429`} fill={ORANGE} />
          <text x={X1(LIP) + 36} y="429" font-size="14" font-weight="700" fill={ORANGE}>80mm minimum</text>
          <text x={X1(0) - 36} y="420" font-size="13" fill={DARK} text-anchor="end">Straight edge across</text>
          <text x={X1(0) - 36} y="436" font-size="13" fill={DARK} text-anchor="end">both ski heels</text>
          <text x={X1(LIP) + 22} y={Y1(0) - 6} font-size="13" fill={DARK}>Van lip</text>
          <!-- forward arrow -->
          <line x1="300" y1="300" x2="140" y2="300" stroke={DARK} stroke-width="2" />
          <polygon points="130,300 146,292 146,308" fill={DARK} />
          <text x="150" y="288" font-size="13" fill={DARK}>Seat further forward:</text>
          <text x="150" y="326" font-size="13" fill={DARK}>more head clearance,</text>
          <text x="150" y="342" font-size="13" fill={DARK}>fixings land elsewhere</text>
          <text x="60" y="90" font-size="14" font-weight="700" fill={DARK}>FRONT OF VAN</text>
        </svg>
        <figcaption class="text-sm text-gray-500 mt-3">Figure 1. Measuring the seat position. Seat drawn from the ROAM design model, shown at the 80mm position. Seat, floor, lip and D pillar to one scale; D pillar and roof measured on a VW T6 LWB with the seat fitted at 115mm, shown here moved back to 80mm. Belt reel gap and labels enlarged for clarity.</figcaption>
      </figure>
    </section>

    <!-- 4 Head clearance -->
    <section id="head" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">4. Head clearance</h2>
      <p class="mb-4">
        In the rear travel seat, a seated occupant's head can be close to the D pillar (the rear structural pillar of the van).
        How close depends on the vehicle, the roof and any pop-top bed, and where the seat is installed. Check every vehicle,
        with the cushions fitted, before you drill.
      </p>
      <ol class="list-decimal pl-6 space-y-2 mb-6">
        <li>Set the vehicle as it will be driven: roof closed, and any pop-top bed, roof bed or overhead cupboards in their travelling position.</li>
        <li>Sit the tallest person who will travel in the seat in it, upright, with the belt fastened.</li>
        <li>Check their head is clear of the roof, the D pillar, the rear window and any fittings, above, beside and behind the head.</li>
        <li>Check that nothing hard or sharp-edged is within reach of the head: roof ribs, pillar or tailgate trim, cupboard edges, lights.</li>
        <li>Record the seat position and that person's height on the handover.</li>
      </ol>

      <figure class="bg-white border border-gray-200 rounded-xl p-4 mb-6">
        <svg viewBox="0 0 720 380" class="w-full h-auto" role="img" aria-label="Head clearance check: seated occupant with the roof and D pillar, and the two options if the head touches">
          <rect width="720" height="380" fill="white" />
          <!-- roof / pop-top bed (varies) -->
          <g transform={`translate(${X2(LIP - MEAS)} ${f2.y0}) scale(${f2.s} ${-f2.s})`}>
            <rect x="0" y="1306" width={MEAS} height="188" fill="#6b7280" />
            <path d={seat.roof} fill="#6b7280" stroke={DARK} stroke-width="1.2" vector-effect="non-scaling-stroke" />
          </g>
          <text x="30" y="14" font-size="12" fill={DARK}>Roof and D pillar (measured, VW T6 LWB)</text>
          <!-- D pillar to scale, rear door, floor and lip -->
          <text x={X2(LIP) + 14} y={Y2(1290)} font-size="12" fill={DARK}>D pillar</text>
          <rect x={X2(LIP)} y={Y2(1306)} width="9" height={Y2(0) + 10 - Y2(1306)} fill={LIGHT} stroke={DARK} stroke-width="1.5" />
          <line x1="30" y1={Y2(0)} x2={X2(LIP)} y2={Y2(0)} stroke={DARK} stroke-width="3" />
          <!-- ROAM rear seat -->
          <g transform={`translate(${f2.x0} ${f2.y0}) scale(${f2.s} ${-f2.s})`}>
            {seat.cushions.map((d) => <path d={d} fill={ORANGE} stroke="#b45f02" stroke-width="1" vector-effect="non-scaling-stroke" />)}
            <path d={seat.frame} fill="#d4d4d8" fill-rule="evenodd" stroke={DARK} stroke-width="1.2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            <path d={seat.detail} fill="none" stroke="#52525b" stroke-width="0.8" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          </g>
          <!-- occupants: average (50th percentile) UK adult male, black; child 8-9 years (95th percentile) from the design model, grey -->
          <g transform={`translate(${f2.x0} ${f2.y0}) scale(${f2.s} ${-f2.s})`}>
            <path d={seat.occupant} fill={DARK} />
            <path d={seat.occupant_arm} fill={DARK} stroke="white" stroke-width="1" vector-effect="non-scaling-stroke" />
            <path d={seat.child} fill="#9ca3af" fill-opacity="0.95" stroke="white" stroke-width="1.2" vector-effect="non-scaling-stroke" />
          </g>
          <circle cx={X2(seat.occupant_head_centre_x)} cy={Y2(seat.occupant_head_top - 116)} r={150 * f2.s} fill="none" stroke={ORANGE} stroke-width="2" stroke-dasharray="4 4" />
          <rect x="30" y="361" width="12" height="12" fill={DARK} />
          <text x="48" y="371" font-size="12" fill={DARK}>Average adult male</text>
          <rect x="170" y="361" width="12" height="12" fill="#9ca3af" />
          <text x="188" y="371" font-size="12" fill={DARK}>Child, 8-9 years</text>
          <!-- flow chart -->
          <rect x="370" y="24" width="320" height="64" rx="8" fill={LIGHT} stroke={DARK} stroke-width="1.5" />
          <text x="530" y="50" font-size="13" font-weight="700" fill={DARK} text-anchor="middle">Is the head clear of the roof, D pillar,</text>
          <text x="530" y="68" font-size="13" font-weight="700" fill={DARK} text-anchor="middle">window and fittings, with nothing hard in reach?</text>
          <line x1="450" y1="88" x2="450" y2="128" stroke={DARK} stroke-width="2" />
          <polygon points="450,136 444,124 456,124" fill={DARK} />
          <text x="458" y="114" font-size="13" font-weight="700" fill="#15803d">Yes</text>
          <rect x="370" y="138" width="150" height="70" rx="8" fill="#dcfce7" stroke="#15803d" stroke-width="1.5" />
          <text x="445" y="164" font-size="12" fill={DARK} text-anchor="middle">Record seat position</text>
          <text x="445" y="180" font-size="12" fill={DARK} text-anchor="middle">and that person's height</text>
          <text x="445" y="196" font-size="12" fill={DARK} text-anchor="middle">on the handover</text>
          <line x1="610" y1="88" x2="610" y2="128" stroke={DARK} stroke-width="2" />
          <polygon points="610,136 604,124 616,124" fill={DARK} />
          <text x="618" y="114" font-size="13" font-weight="700" fill="#b91c1c">Touches or tight</text>
          <rect x="540" y="138" width="160" height="88" rx="8" fill="#fee2e2" stroke="#b91c1c" stroke-width="1.5" />
          <text x="620" y="162" font-size="12" font-weight="700" fill={DARK} text-anchor="middle">Either</text>
          <text x="620" y="180" font-size="12" fill={DARK} text-anchor="middle">move the seat forward,</text>
          <text x="620" y="196" font-size="12" fill={DARK} text-anchor="middle">re-check the underbody</text>
          <text x="620" y="212" font-size="12" fill={DARK} text-anchor="middle">and repeat the check</text>
          <rect x="540" y="248" width="160" height="70" rx="8" fill="#fee2e2" stroke="#b91c1c" stroke-width="1.5" />
          <text x="620" y="272" font-size="12" font-weight="700" fill={DARK} text-anchor="middle">Or</text>
          <text x="620" y="290" font-size="12" fill={DARK} text-anchor="middle">that person does not</text>
          <text x="620" y="306" font-size="12" fill={DARK} text-anchor="middle">travel in that seat</text>
        </svg>
        <figcaption class="text-sm text-gray-500 mt-3">Figure 2. Head clearance check. Seat from the ROAM design model at the 80mm position; seat, D pillar and roof to one scale (roof measured on a VW T6 LWB with the seat at 115mm); black figure: average (50th percentile) UK adult male built from published body dimensions (Pheasant, Bodyspace), sitting upright against the backrest with the cushion compressed 30mm (measured); grey figure: child aged 8-9 years (95th percentile) from the ROAM design model. Always check with the tallest person who will travel.</figcaption>
      </figure>

      <p>
        If the head touches, or the space is tight, the position is not suitable for that person. Either move the seat further
        forward and repeat the check, or that person should not travel in that seat. We cannot assess head clearance in an
        individual vehicle.
      </p>
    </section>

    <!-- 5 Underbody -->
    <section id="underbody" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">5. Underbody and spreader plates</h2>
      <ul class="list-disc pl-6 space-y-2 mb-6">
        <li>Survey underneath before drilling. Check what each hole will pass through (chassis rail, crossmember or floor panel), and keep clear of fuel lines, brake pipes, wiring, the fuel tank, heat shields and the rear shock absorber mounts. On a VW T6 the front fixing on one side can fall over a shock absorber mount; if a front fixing cannot be fitted safely, leave it out (the rear 4 on each side are a must).</li>
        <li>Fit a steel plate under every fixing, at least 100 x 100 x 4mm, sitting flat against the underside. The plates have a clearance hole for the factory captive nut, so do not remove the captive nuts. On earlier kits, if the round hole does not clear the captive nut, open the hole up to 20mm diameter round, no larger. Additional floor spreader plates are available from us. Pressings and ribs vary between vehicles, so decide how to get a flat, full-contact plate on each one.</li>
        <li>Several ROAM fixings are close together. Where they are, a larger plate covering both may be needed.</li>
        <li>Where a fixing is close to a chassis member, a plate can be folded to clear it, but not cut smaller.</li>
        <li>Where a bolt passes through a hollow section, fit an anti-crush tube if you can, so the section does not collapse when the bolt is tightened. If one cannot be fitted, do not tighten the bolt hard enough to crush the section, and record what you did.</li>
      </ul>

      <figure class="bg-white border border-gray-200 rounded-xl p-4">
        <svg viewBox="0 0 720 480" class="w-full h-auto" role="img" aria-label="Plan view of the twelve fixing holes, six in each ski, with the rear four on each side marked as mandatory">
          <rect width="720" height="480" fill="white" />
          <text x="360" y="26" font-size="14" font-weight="700" fill={DARK} text-anchor="middle">FRONT OF VAN</text>
          <line x1="360" y1="34" x2="360" y2="60" stroke={DARK} stroke-width="2" />
          <polygon points="360,30 353,44 367,44" fill={DARK} />
          {[leftX, rightX].map((x) => (
            <rect x={x - 13} y={yOf(skiLen)} width="26" height={skiLen * sc} rx="3" fill={LIGHT} stroke={DARK} stroke-width="2" />
          ))}
          {[leftX, rightX].map((x) =>
            holes.map((d, i) => (
              <circle cx={x} cy={yOf(d)} r="6" fill={i < 4 ? ORANGE : 'white'} stroke={i < 4 ? ORANGE : DARK} stroke-width="2" />
            ))
          )}
          {holes.map((d) => (
            <g>
              <line x1={leftX - 20} y1={yOf(d)} x2={leftX - 60} y2={yOf(d)} stroke={GREY} stroke-width="1" />
              <text x={leftX - 66} y={yOf(d) + 4} font-size="12" fill={DARK} text-anchor="end">{d}</text>
            </g>
          ))}
          <text x={leftX - 66} y={yOf(skiLen) - 10} font-size="12" fill={DARK} text-anchor="end">mm from heel</text>
          <line x1={leftX - 40} y1={heelY} x2={rightX + 40} y2={heelY} stroke={DARK} stroke-width="1.5" stroke-dasharray="6 4" />
          <text x={rightX + 46} y={heelY + 4} font-size="12" fill={DARK}>Ski heels</text>
          <line x1={leftX} y1={heelY + 24} x2={rightX} y2={heelY + 24} stroke={DARK} stroke-width="1.5" />
          <polygon points={`${leftX},${heelY + 24} ${leftX + 10},${heelY + 19} ${leftX + 10},${heelY + 29}`} fill={DARK} />
          <polygon points={`${rightX},${heelY + 24} ${rightX - 10},${heelY + 19} ${rightX - 10},${heelY + 29}`} fill={DARK} />
          <text x={(leftX + rightX) / 2} y={heelY + 44} font-size="13" fill={DARK} text-anchor="middle">1114mm between hole rows</text>
          <text x="360" y={heelY + 62} font-size="14" font-weight="700" fill={DARK} text-anchor="middle">REAR DOORS</text>
          <!-- key -->
          <circle cx="256" cy="160" r="6" fill={ORANGE} stroke={ORANGE} stroke-width="2" />
          <text x="270" y="165" font-size="13" fill={DARK}>Rear 4 each side: must be fitted</text>
          <circle cx="256" cy="188" r="6" fill="white" stroke={DARK} stroke-width="2" />
          <text x="270" y="193" font-size="13" fill={DARK}>Front 2 each side: fit where reachable</text>
          <text x="250" y="226" font-size="12" fill={DARK}>The rear two holes on each side are 36mm apart:</text>
          <text x="250" y="242" font-size="12" fill={DARK}>one plate may need to cover both.</text>
        </svg>
        <figcaption class="text-sm text-gray-500 mt-3">Figure 3. Fixing holes, plan view. Hole positions taken from the ROAM design model; check them against the seat you have.</figcaption>
      </figure>
    </section>

    <!-- 6 Fixings -->
    <section id="fixings" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">6. Drilling and fixing</h2>
      <ul class="list-disc pl-6 space-y-2 mb-6">
        <li>Drill 13mm. Check underneath before every hole, including for the rear shock absorber mounts.</li>
        <li>Bolt length depends on your floor build-up (ply, insulation, original floor), the plates and the washers. Check every fixing.</li>
        <li>With all plates and washers fitted, at least two full threads must show through the nyloc. If a bolt is too short, do not fit it.</li>
        <li>Tighten all fixings securely, and seal every hole against water and corrosion.</li>
      </ul>

      <figure class="bg-white border border-gray-200 rounded-xl p-4">
        <svg viewBox="0 0 720 400" class="w-full h-auto" role="img" aria-label="Section through one fixing showing bolt, washer, seat ski, floor build-up, vehicle floor, spreader plate, washer, nyloc nut and at least two threads">
          <rect width="720" height="400" fill="white" />
          <!-- bolt head and washer -->
          <polygon points="262,36 338,36 346,48 338,60 262,60 254,48" fill={GREY} stroke={DARK} stroke-width="2" />
          <rect x="246" y="60" width="108" height="8" fill={LIGHT} stroke={DARK} stroke-width="1.5" />
          <!-- seat ski -->
          <rect x="120" y="68" width="360" height="10" fill={DARK} />
          <!-- floor build-up -->
          <rect x="80" y="78" width="440" height="52" fill="#fde7c8" stroke={DARK} stroke-width="1.5" />
          <!-- vehicle floor -->
          <rect x="60" y="130" width="480" height="8" fill="#6b7280" stroke={DARK} stroke-width="1" />
          <!-- spreader plate -->
          <rect x="190" y="138" width="220" height="16" fill={ORANGE} stroke={DARK} stroke-width="1.5" />
          <!-- washer and nyloc -->
          <rect x="246" y="154" width="108" height="8" fill={LIGHT} stroke={DARK} stroke-width="1.5" />
          <rect x="262" y="162" width="76" height="26" fill={GREY} stroke={DARK} stroke-width="2" />
          <rect x="262" y="180" width="76" height="8" fill="#60a5fa" />
          <!-- bolt shank -->
          <rect x="288" y="68" width="24" height="152" fill="#d1d5db" stroke={DARK} stroke-width="1.5" />
          <line x1="288" y1="196" x2="312" y2="200" stroke={DARK} stroke-width="1.5" />
          <line x1="288" y1="204" x2="312" y2="208" stroke={DARK} stroke-width="1.5" />
          <line x1="288" y1="212" x2="312" y2="216" stroke={DARK} stroke-width="1.5" />
          <!-- labels -->
          <g font-size="13" fill={DARK}>
            <line x1="346" y1="48" x2="540" y2="44" stroke={GREY} />
            <text x="546" y="48">M12 bolt, grade 8.8 minimum</text>
            <line x1="480" y1="73" x2="540" y2="72" stroke={GREY} />
            <text x="546" y="76">ROAM seat ski</text>
            <line x1="520" y1="104" x2="540" y2="102" stroke={GREY} />
            <text x="546" y="106">Floor build-up (ply, insulation)</text>
            <line x1="540" y1="134" x2="546" y2="134" stroke={GREY} />
            <text x="552" y="138">Vehicle floor or chassis</text>
            <line x1="410" y1="146" x2="540" y2="160" stroke={GREY} />
            <text x="546" y="164" font-weight="700" fill={ORANGE}>Steel plate, min 100 x 100 x 4mm</text>
            <line x1="338" y1="175" x2="540" y2="188" stroke={GREY} />
            <text x="546" y="192">Washer and nyloc nut</text>
            <line x1="312" y1="208" x2="540" y2="216" stroke={GREY} />
            <text x="546" y="220" font-weight="700" fill={ORANGE}>At least 2 full threads</text>
            <text x="546" y="236" font-weight="700" fill={ORANGE}>through the nyloc</text>
            <line x1="288" y1="104" x2="170" y2="196" stroke={GREY} />
            <text x="164" y="210" text-anchor="end">13mm hole</text>
          </g>
          <!-- inset: close fixings -->
          <text x="60" y="282" font-size="13" font-weight="700" fill={DARK}>Fixings close together: one larger plate</text>
          <rect x="60" y="296" width="230" height="80" fill={ORANGE} stroke={DARK} stroke-width="1.5" />
          <circle cx="140" cy="336" r="7" fill="white" stroke={DARK} stroke-width="2" />
          <circle cx="210" cy="336" r="7" fill="white" stroke={DARK} stroke-width="2" />
          <text x="175" y="392" font-size="12" fill={DARK} text-anchor="middle">plan view, under the floor</text>
          <text x="340" y="282" font-size="13" font-weight="700" fill={DARK}>Near a chassis member: fold, do not cut</text>
          <polyline points="340,370 520,370 520,300" fill="none" stroke={ORANGE} stroke-width="8" />
          <rect x="530" y="290" width="40" height="90" fill="#6b7280" />
          <text x="580" y="338" font-size="12" fill={DARK}>Chassis</text>
          <text x="580" y="354" font-size="12" fill={DARK}>member</text>
        </svg>
        <figcaption class="text-sm text-gray-500 mt-3">Figure 4. Section through one fixing, and plate arrangements. Schematic, not to scale.</figcaption>
      </figure>
    </section>

    <!-- 7 Judgement calls -->
    <section id="judgement" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">7. Your judgement calls</h2>
      <p class="mb-4">These vary from van to van, and only the installer can decide them on the vehicle.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-gray-200">
          <thead class="bg-roam-light text-left font-heading">
            <tr><th class="p-3">Decision</th><th class="p-3">What to consider</th></tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr><td class="p-3 font-semibold">Seat position</td><td class="p-3">Head clearance, belt reel clearance to the rear window, and what each fixing lands on underneath.</td></tr>
            <tr><td class="p-3 font-semibold">Roof and pop-top bed</td><td class="p-3">How low the bed, roof frame or overhead lockers sit in the travelling position, and any hard edges within reach of the head.</td></tr>
            <tr><td class="p-3 font-semibold">Underbody</td><td class="p-3">Chassis rail, crossmember or floor panel at each hole; fuel, brake and wiring routes; heat shields.</td></tr>
            <tr><td class="p-3 font-semibold">Plates</td><td class="p-3">Flat, full contact at every fixing; one larger plate where fixings are close; fold, do not cut, near a chassis member; pressings and ribs.</td></tr>
            <tr><td class="p-3 font-semibold">Hollow sections</td><td class="p-3">Whether an anti-crush tube can be fitted, and what to do if it cannot.</td></tr>
            <tr><td class="p-3 font-semibold">Bolt length</td><td class="p-3">Floor build-up, plates and washers, so that two full threads show through the nyloc.</td></tr>
            <tr><td class="p-3 font-semibold">Surrounding furniture</td><td class="p-3">Kitchen pods, lockers, tables and trim within reach of an occupant's head. Rounded edges and padding reduce the risk.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 8 Handover -->
    <section id="handover" class="scroll-mt-28">
      <h2 class="font-heading text-3xl font-bold text-roam-dark mb-4">8. Handover</h2>
      <p class="mb-3">Tell the owner:</p>
      <ul class="list-disc pl-6 space-y-2">
        <li>the seat position, and the height of the tallest person it was checked for</li>
        <li>that only the rear belted seat is for use when travelling, and the side benches are not</li>
        <li>that the fixings should be re-checked after the first 500 miles.</li>
      </ul>
    </section>

  </div>
</Layout>
