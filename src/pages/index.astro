---
import HomeLayout from '../layouts/HomeLayout.astro';
import { Hero } from '../components/home/Hero.tsx';
import { TrustMarquee } from '../components/home/TrustMarquee.tsx';
import { FeaturedProduct } from '../components/home/FeaturedProduct.tsx';
import { ProductGrid } from '../components/home/ProductGrid.tsx';
import { HowItWorks } from '../components/home/HowItWorks.tsx';
import { WhyRoam } from '../components/home/WhyRoam.tsx';
import { FAQ } from '../components/home/FAQ.tsx';
---

<HomeLayout
  title="Campervan Furniture Specialists"
  description="Premium M1 certified campervan furniture — seating frames, kitchen pods, storage & upholstery. UK made and delivered by Romark Engineering."
>
  <Hero client:load />
  <TrustMarquee client:visible />
  <FeaturedProduct client:visible />
  <ProductGrid client:visible />
  <HowItWorks client:visible />
  <WhyRoam client:visible />
  <FAQ client:visible />
</HomeLayout>
