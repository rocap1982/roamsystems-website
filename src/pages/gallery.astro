---
import Layout from '../layouts/Layout.astro';
import { promises as fs } from 'fs';
import path from 'path';

// Gallery categories — directly map to subfolders under public/images/gallery/
// Order defines the order the filter pills appear.
const CATEGORIES: { slug: string; label: string }[] = [
  { slug: 'builds',     label: 'Builds' },
  { slug: 'frames',     label: 'Frames' },
  { slug: 'kitchens',   label: 'Kitchens' },
  { slug: 'upholstery', label: 'Upholstery' },
];

type GalleryImage = { src: string; category: string };

// Walk each category subfolder and collect images
const galleryDir = path.join(process.cwd(), 'public/images/gallery');
const images: GalleryImage[] = [];

for (const { slug } of CATEGORIES) {
  try {
    const dir = path.join(galleryDir, slug);
    const files = await fs.readdir(dir);
    const imgs = files
      .filter(f => /\.(jpg|jpeg|png|webp|gif|avif)$/i.test(f))
      .sort()
      .map(f => ({ src: `/images/gallery/${slug}/${f}`, category: slug }));
    images.push(...imgs);
  } catch {
    // Folder may not exist yet — skip silently
  }
}

// Count per category for the pill labels
const counts: Record<string, number> = Object.fromEntries(
  CATEGORIES.map(c => [c.slug, images.filter(i => i.category === c.slug).length])
);
const total = images.length;
---

<Layout title="Photo Gallery" description="See ROAM Systems campervan furniture installed in real conversions. M1 certified seating frames, kitchen pods, storage and upholstery photo gallery.">

  <!-- Header -->
  <section class="bg-roam-dark text-white py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-extrabold mb-4">Photo Gallery</h1>
      <p class="text-gray-300 max-w-2xl mx-auto">Browse our gallery of campervan builds, product installations, and customer conversions.</p>
      <p class="text-roam-orange font-heading font-semibold mt-4">{total} Photos</p>
    </div>
  </section>

  <!-- Filter pills -->
  <section class="bg-roam-light pt-10">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-3">
        <button
          type="button"
          class="gallery-filter px-5 py-2 rounded-full font-heading font-semibold text-sm transition-all border-2 border-roam-dark bg-roam-dark text-white"
          data-filter="all"
        >
          All <span class="opacity-70 ml-1">({total})</span>
        </button>
        {CATEGORIES.filter(c => counts[c.slug] > 0).map(c => (
          <button
            type="button"
            class="gallery-filter px-5 py-2 rounded-full font-heading font-semibold text-sm transition-all border-2 border-roam-dark bg-white text-roam-dark hover:bg-roam-dark hover:text-white"
            data-filter={c.slug}
          >
            {c.label} <span class="opacity-70 ml-1">({counts[c.slug]})</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-10 bg-roam-light">
    <div class="max-w-7xl mx-auto px-4">
      <div id="gallery-grid" class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
        {images.map((img, i) => (
          <div class="gallery-cell break-inside-avoid" data-category={img.category}>
            <button
              class="gallery-item w-full rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all cursor-pointer group"
              data-image={img.src}
              data-index={i}
            >
              <img
                src={img.src}
                alt={`Gallery image ${i + 1}`}
                class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[300] hidden bg-black/90 flex items-center justify-center">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-roam-orange z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <button id="lightbox-prev" class="absolute left-4 text-white hover:text-roam-orange z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 text-white hover:text-roam-orange z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
    <img id="lightbox-image" src="" alt="Gallery preview" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" />
    <div id="lightbox-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/70 text-sm font-heading"></div>
  </div>

</Layout>

<script>
  // --- Filter pills ---
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.gallery-cell'));

  function setActiveButton(activeBtn: HTMLButtonElement) {
    filterButtons.forEach(btn => {
      btn.classList.remove('bg-roam-dark', 'text-white');
      btn.classList.add('bg-white', 'text-roam-dark');
    });
    activeBtn.classList.remove('bg-white', 'text-roam-dark');
    activeBtn.classList.add('bg-roam-dark', 'text-white');
  }

  function applyFilter(filter: string) {
    cells.forEach(cell => {
      const show = filter === 'all' || cell.dataset.category === filter;
      cell.style.display = show ? '' : 'none';
    });
    // Rebuild lightbox image list from currently visible items so prev/next works correctly
    rebuildLightboxList();
  }

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      setActiveButton(btn);
      applyFilter(btn.dataset.filter || 'all');
    });
  });

  // --- Lightbox ---
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxCounter = document.getElementById('lightbox-counter');
  let visibleImages: string[] = [];
  let currentIndex = 0;

  function rebuildLightboxList() {
    visibleImages = cells
      .filter(cell => cell.style.display !== 'none')
      .map(cell => {
        const btn = cell.querySelector<HTMLElement>('.gallery-item');
        return btn?.dataset.image || '';
      });
  }

  function showImage(index: number) {
    if (visibleImages.length === 0) return;
    currentIndex = ((index % visibleImages.length) + visibleImages.length) % visibleImages.length;
    if (lightboxImage) lightboxImage.src = visibleImages[currentIndex];
    if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${visibleImages.length}`;
  }

  function openLightbox(startSrc: string) {
    rebuildLightboxList();
    const idx = visibleImages.indexOf(startSrc);
    showImage(idx >= 0 ? idx : 0);
    lightbox?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.gallery-item').forEach(item => {
    item.addEventListener('click', () => {
      openLightbox(item.dataset.image || '');
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => showImage(currentIndex - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => showImage(currentIndex + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });

  // Initialise visible list on load
  rebuildLightboxList();
</script>
